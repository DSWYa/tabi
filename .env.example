# ---- Frontend (PUBLIC) -------------------------------------------------------
# These are bundled into the browser app. They are safe to publish: the
# publishable/anon key only grants what Postgres row-level security allows.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=paste-the-publishable-or-anon-key-here

# ---- Scripts only (PRIVATE — never prefix with VITE_, never commit) ------------
# Used by `npm run seed:dev` to create the fictional dev users.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=paste-the-secret-or-service-role-key-here
